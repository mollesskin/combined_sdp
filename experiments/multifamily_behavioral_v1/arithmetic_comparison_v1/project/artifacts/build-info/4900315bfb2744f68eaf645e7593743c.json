{"id":"4900315bfb2744f68eaf645e7593743c","_format":"hh-sol-build-info-1","solcVersion":"0.4.25","solcLongVersion":"0.4.25+commit.59dbf8f1","input":{"language":"Solidity","sources":{"contracts/V3/integer_overflow_mul.sol":{"content":"/*\n * @source: https://github.com/SmartContractSecurity/SWC-registry/blob/master/test_cases/integer_overflow_and_underflow/integer_overflow_mul.sol\n * @author: -\n * @vulnerable_at_lines: 17\n */\n\n//Single transaction overflow\n//Post-transaction effect: overflow escapes to publicly-readable storage\n\npragma solidity ^0.4.19;\n\ncontract IntegerOverflowMul {\n    uint public count = 2;\n\n    function run(uint256 input) public {\n        // <yes> <report> ARITHMETIC\n        require(count == 0 || input <= uint256(-1) / count);\n        count = ResearchChecked.mul(count, input);\n    }\n}\n\n// AI-assisted experimental checked arithmetic; not an original SafeMath release.\n// Post-result add/mul checks follow the idiom in this dataset's BECToken SafeMath.\nlibrary ResearchChecked {\n function add(uint a,uint b) internal pure returns(uint) { uint c=a+b; require(c>=a); return c; }\n function sub(uint a,uint b) internal pure returns(uint) { require(b<=a); return a-b; }\n function mul(uint a,uint b) internal pure returns(uint) { uint c=a*b; require(a==0 || c/a==b); return c; }\n}\n"}},"settings":{"optimizer":{"enabled":true,"runs":200},"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","evm.methodIdentifiers","metadata"],"":["ast"]}}}},"output":{"sources":{"contracts/V3/integer_overflow_mul.sol":{"ast":{"absolutePath":"contracts/V3/integer_overflow_mul.sol","exportedSymbols":{"IntegerOverflowMul":[34],"ResearchChecked":[109]},"id":110,"nodeType":"SourceUnit","nodes":[{"id":1,"literals":["solidity","^","0.4",".19"],"nodeType":"PragmaDirective","src":"299:24:0"},{"baseContracts":[],"contractDependencies":[],"contractKind":"contract","documentation":null,"fullyImplemented":true,"id":34,"linearizedBaseContracts":[34],"n