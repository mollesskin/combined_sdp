{"id":"1e5c45f55d35fa46f463588378b6596d","_format":"hh-sol-build-info-1","solcVersion":"0.4.25","solcLongVersion":"0.4.25+commit.59dbf8f1","input":{"language":"Solidity","sources":{"contracts/V2/timelock.sol":{"content":"/*\n * @source: https://github.com/sigp/solidity-security-blog\n * @author: -\n * @vulnerable_at_lines: 22\n */\n\n//added pragma version\n pragma solidity ^0.4.10;\n \n contract TimeLock {\n\n     mapping(address => uint) public balances;\n     mapping(address => uint) public lockTime;\n\n     function deposit() public payable {\n         balances[msg.sender] += msg.value;\n         lockTime[msg.sender] = now + 1 weeks;\n     }\n\n     function increaseLockTime(uint _secondsToIncrease) public {\n         // <yes> <report> ARITHMETIC\n         require(_secondsToIncrease <= uint256(-1) - lockTime[msg.sender]);\n        lockTime[msg.sender] = lockTime[msg.sender] + _secondsToIncrease;\n     }\n\n     function withdraw() public {\n         require(balances[msg.sender] > 0);\n         require(now > lockTime[msg.sender]);\n         uint transferValue = balances[msg.sender];\n         balances[msg.sender] = 0;\n         msg.sender.transfer(transferValue);\n     }\n }\n"}},"settings":{"optimizer":{"enabled":true,"runs":200},"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","evm.methodIdentifiers","metadata"],"":["ast"]}}}},"output":{"sources":{"contracts/V2/timelock.sol":{"ast":{"absolutePath":"contracts/V2/timelock.sol","exportedSymbols":{"TimeLock":[107]},"id":108,"nodeType":"SourceUnit","nodes":[{"id":1,"literals":["solidity","^","0.4",".10"],"nodeType":"PragmaDirective","src":"133:24:0"},{"baseContracts":[],"contractDependencies":[],"contractKind":"contract","documentation":null,"fullyImplemented":true,"id":107,"linearizedBaseContracts":[107],"name":"TimeLock","nodeType":"ContractDefinition","nodes":[{"constant":false,"id":5,"name":"balances","nodeType":"VariableDeclaration","scope":107,"src":"187:40:0","stateVariable":true,"stor