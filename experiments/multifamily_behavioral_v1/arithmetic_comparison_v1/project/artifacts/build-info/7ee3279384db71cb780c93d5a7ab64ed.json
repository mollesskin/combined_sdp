{"id":"7ee3279384db71cb780c93d5a7ab64ed","_format":"hh-sol-build-info-1","solcVersion":"0.4.25","solcLongVersion":"0.4.25+commit.59dbf8f1","input":{"language":"Solidity","sources":{"contracts/V3/integer_overflow_mapping_sym_1.sol":{"content":"/*\n * @source: https://github.com/SmartContractSecurity/SWC-registry/blob/master/test_cases/integer_overflow_and_underflow/integer_overflow_mapping_sym_1.sol\n * @author: -\n * @vulnerable_at_lines: 16\n */\n\n//Single transaction overflow\n\npragma solidity ^0.4.11;\n\ncontract IntegerOverflowMappingSym1 {\n    mapping(uint256 => uint256) map;\n\n    function init(uint256 k, uint256 v) public {\n        // <yes> <report> ARITHMETIC\n        require(v <= map[k]);\n        map[k] = ResearchChecked.sub(map[k], v);\n    }\n}\n\n// AI-assisted experimental checked arithmetic; not an original SafeMath release.\n// Post-result add/mul checks follow the idiom in this dataset's BECToken SafeMath.\nlibrary ResearchChecked {\n function add(uint a,uint b) internal pure returns(uint) { uint c=a+b; require(c>=a); return c; }\n function sub(uint a,uint b) internal pure returns(uint) { require(b<=a); return a-b; }\n function mul(uint a,uint b) internal pure returns(uint) { uint c=a*b; require(a==0 || c/a==b); return c; }\n}\n"}},"settings":{"optimizer":{"enabled":true,"runs":200},"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","evm.methodIdentifiers","metadata"],"":["ast"]}}}},"output":{"sources":{"contracts/V3/integer_overflow_mapping_sym_1.sol":{"ast":{"absolutePath":"contracts/V3/integer_overflow_mapping_sym_1.sol","exportedSymbols":{"IntegerOverflowMappingSym1":[34],"ResearchChecked":[109]},"id":110,"nodeType":"SourceUnit","nodes":[{"id":1,"literals":["solidity","^","0.4",".11"],"nodeType":"PragmaDirective","src":"236:24:0"},{"baseContracts":[],"contractDependencies":[],"contractKind":"contract","documentation":null,"fullyImplemented":true,"id":34,"linearizedBaseContracts":[34],"name":"IntegerOverflowMappingSym1"