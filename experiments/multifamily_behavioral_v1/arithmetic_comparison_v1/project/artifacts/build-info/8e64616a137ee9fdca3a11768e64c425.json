{"id":"8e64616a137ee9fdca3a11768e64c425","_format":"hh-sol-build-info-1","solcVersion":"0.4.25","solcLongVersion":"0.4.25+commit.59dbf8f1","input":{"language":"Solidity","sources":{"contracts/V3/integer_overflow_minimal.sol":{"content":"/*\n * @source: https://github.com/SmartContractSecurity/SWC-registry/blob/master/test_cases/integer_overflow_and_underflow/integer_overflow_minimal.sol\n * @author: -\n * @vulnerable_at_lines: 17\n */\n\n//Single transaction overflow\n//Post-transaction effect: overflow escapes to publicly-readable storage\n\npragma solidity ^0.4.19;\n\ncontract IntegerOverflowMinimal {\n    uint public count = 1;\n\n    function run(uint256 input) public {\n        // <yes> <report> ARITHMETIC\n        require(input <= count);\n        count = ResearchChecked.sub(count, input);\n    }\n}\n\n// AI-assisted experimental checked arithmetic; not an original SafeMath release.\n// Post-result add/mul checks follow the idiom in this dataset's BECToken SafeMath.\nlibrary ResearchChecked {\n function add(uint a,uint b) internal pure returns(uint) { uint c=a+b; require(c>=a); return c; }\n function sub(uint a,uint b) internal pure returns(uint) { require(b<=a); return a-b; }\n function mul(uint a,uint b) internal pure returns(uint) { uint c=a*b; require(a==0 || c/a==b); return c; }\n}\n"}},"settings":{"optimizer":{"enabled":true,"runs":200},"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","evm.methodIdentifiers","metadata"],"":["ast"]}}}},"output":{"sources":{"contracts/V3/integer_overflow_minimal.sol":{"ast":{"absolutePath":"contracts/V3/integer_overflow_minimal.sol","exportedSymbols":{"IntegerOverflowMinimal":[25],"ResearchChecked":[100]},"id":101,"nodeType":"SourceUnit","nodes":[{"id":1,"literals":["solidity","^","0.4",".19"],"nodeType":"PragmaDirective","src":"303:24:0"},{"baseContracts":[],"contractDependencies":[],"contractKind":"contract","documentation":null,"fullyImplemented":true,"id":25,"linearizedBaseContracts":[25],"name"