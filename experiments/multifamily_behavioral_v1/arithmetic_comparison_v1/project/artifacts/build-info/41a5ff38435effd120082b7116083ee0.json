{"id":"41a5ff38435effd120082b7116083ee0","_format":"hh-sol-build-info-1","solcVersion":"0.4.25","solcLongVersion":"0.4.25+commit.59dbf8f1","input":{"language":"Solidity","sources":{"contracts/V3/integer_overflow_multitx_onefunc_feasible.sol":{"content":"/*\n * @source: https://github.com/ConsenSys/evm-analyzer-benchmark-suite\n * @author: Suhabe Bugrara\n * @vulnerable_at_lines: 22\n */\n\n//Multi-transactional, single function\n//Arithmetic instruction reachable\n\npragma solidity ^0.4.23;\n\ncontract IntegerOverflowMultiTxOneFuncFeasible {\n    uint256 private initialized = 0;\n    uint256 public count = 1;\n\n    function run(uint256 input) public {\n        if (initialized == 0) {\n            initialized = 1;\n            return;\n        }\n        // <yes> <report> ARITHMETIC\n        require(input <= count);\n        count = ResearchChecked.sub(count, input);\n    }\n}\n\n// AI-assisted experimental checked arithmetic; not an original SafeMath release.\n// Post-result add/mul checks follow the idiom in this dataset's BECToken SafeMath.\nlibrary ResearchChecked {\n function add(uint a,uint b) internal pure returns(uint) { uint c=a+b; require(c>=a); return c; }\n function sub(uint a,uint b) internal pure returns(uint) { require(b<=a); return a-b; }\n function mul(uint a,uint b) internal pure returns(uint) { uint c=a*b; require(a==0 || c/a==b); return c; }\n}\n"}},"settings":{"optimizer":{"enabled":true,"runs":200},"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","evm.methodIdentifiers","metadata"],"":["ast"]}}}},"output":{"sources":{"contracts/V3/integer_overflow_multitx_onefunc_feasible.sol":{"ast":{"absolutePath":"contracts/V3/integer_overflow_multitx_onefunc_feasible.sol","exportedSymbols":{"IntegerOverflowMultiTxOneFuncFeasible":[38],"ResearchChecked":[113]},"id":114,"nodeType":"SourceUnit","nodes":[{"id":1,"literals":["solidity","^","0.4",".23"],"nodeType":"PragmaDirective","src":"208:24:0"},{"baseContracts":[],"contractDependencie